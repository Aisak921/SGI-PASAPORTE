# ============================================================
# PLANTILLA DE CONFIGURACIÓN — SGI Pasaportes
# ============================================================
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" al repositorio (está en .gitignore).
# Guarda el .env en un lugar seguro solo tuyo (ej: OneDrive personal,
# pendrive encriptado, o gestor de contraseñas como Bitwarden).
# ============================================================

# ─── Telegram ───────────────────────────────────────────────
# Token del bot: obtén uno en https://t.me/BotFather
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# ID del grupo de Soporte TI (número negativo).
# Agrega el bot al grupo y escribe /chatid para obtenerlo.
SUPPORT_CHAT_ID=-100XXXXXXXXXX

# Tu ID personal de Telegram (admin del sistema).
# Entra a https://t.me/userinfobot para obtenerlo.
ADMIN_CHAT_IDS=TU_ID_TELEGRAM

# ─── Groq (transcripción de audio, capa gratuita) ───────────
# Crea una clave en https://console.groq.com/keys
GROQ_API_KEY=gsk_TU_CLAVE_GROQ

# Modelos vigentes en https://console.groq.com/docs/models
GROQ_MODEL_STT=whisper-large-v3-turbo
GROQ_MODEL_LLM=openai/gpt-oss-20b

# ─── PostgreSQL ─────────────────────────────────────────────
# Usa contraseña sin caracteres especiales (@ : / #)
POSTGRES_USER=sgi
POSTGRES_PASSWORD=pon-una-contrasena-segura-aqui
POSTGRES_DB=sgi

# ─── Correo a Jefatura (SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=tu-correo@gmail.com
# Gmail: genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (requiere 2FA)
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=SGI Pasaportes <tu-correo@gmail.com>
JEFE_EMAIL=jefe@correo.com

# ─── Excel en OneDrive ──────────────────────────────────────
# Ruta del HOST hacia la carpeta que sincroniza tu OneDrive.
ONEDRIVE_LOCAL_FOLDER=C:\Users\TU_USUARIO\OneDrive\Oficina Pasaporte
ONEDRIVE_INVENTARIO_XLSX=/data/onedrive/Inventario Oficina Pasaportes - copia.xlsx
ONEDRIVE_SOPORTE_XLSX=/data/onedrive/Reporte_Gestion_Soporte_TI.xlsx

# ─── Otros ──────────────────────────────────────────────────
TIMEZONE=America/Bogota
LOG_LEVEL=INFO

# ─── OneDrive API (opcional, solo si usas sincronización directa) ──
ENABLE_CLOUD_API_SYNC=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
ONEDRIVE_REMOTE_FOLDER=/SGI-Pasaportes

# ─── ngrok (túnel público opcional — acceso desde datos móviles) ────
# Crea cuenta gratis en https://dashboard.ngrok.com y copia tu token aquí.
# Luego activa el túnel con: docker compose --profile ngrok up -d
NGROK_AUTHTOKEN=
